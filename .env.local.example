.env.local.example — copy to .env.local and fill in your automation endpoint.

# Where lead submissions are POSTed as JSON.
# Works directly with Make.com (custom webhook), Pabbly Connect, Zapier,
# n8n, or any endpoint that accepts a POST with a JSON body.
LEAD_WEBHOOK_URL=https://hooks.make.com/your-hook-id

# Optional. Sent as `Authorization: Bearer <token>` so the endpoint can verify
# the request really came from this site.
LEAD_WEBHOOK_TOKEN=

# Canonical site URL, used for metadataBase, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://manmitra.example.com
